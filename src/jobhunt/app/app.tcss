/* Minimal CSS for JobHunt TUI */
#nav_bar {
    background: $primary;
    padding: 0 1;
    height: 3;
}

#nav_bar Button {
    margin: 1 1 0 0;
    padding: 0 1;
    min-width: 10;
}

#nav_bar Button.active {
    background: $background;
    color: $primary;
    text-style: bold;
}

#main_content {
    padding: 1;
}

#welcome {
    margin-bottom: 1;
    text-style: bold;
}

#screen_content {
    padding: 1;
    height: 1fr;
}

#chat_messages {
    height: 1fr;
}

/* Keep each page's action buttons aligned on a single row.
   The row is height-expanding by default in Textual, so it must be
   collapsed to auto to avoid eating the page's vertical space. */
ButtonRow {
    height: auto;
    margin-top: 1;
}

ButtonRow > Button {
    margin: 0 1 0 0;
}

ButtonRow > Button:last-child {
    margin-right: 0;
}

/* The input defaults to 100% width, which would push the paired
   action button off screen when both share a row. */
ButtonRow > Input {
    width: 1fr;
}

/* Keep the settings prompt editor compact so it never overlaps
   the blocks above it (LinkedIn login, buttons, etc.). */
#system_prompt {
    height: 6;
}

#linkedin_block {
    height: auto;
}

/* LinkedIn sign-in state colors (applied via the screen's state classes).
   Neutral/in-progress messages keep the default foreground. */
#linkedin_status.signed_in {
    color: $success;
}

#linkedin_status.signed_out {
    color: $error;
}

#linkedin_status {
    margin-bottom: 1;
}

HeaderIcon {
    width: 9;
    padding: 0 2;
    text-style: bold;
    background: $primary;
    color: $background;
}

/* Make the chat input area visually distinct from the transcript. */
#chat_input {
    background: $panel;
    border: tall $secondary;
    padding: 0 2;
}

#chat_input > .input--placeholder {
    color: $primary;
    text-style: italic;
}
