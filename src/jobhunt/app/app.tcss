/* Minimal CSS for JobHunt TUI */
#nav_bar {
    background: $primary;
    padding: 0 1;
    height: 3;
}

#nav_bar Button {
    margin: 1 1 0 0;
    padding: 0 1;
    min-width: 10;
}

#main_content {
    padding: 1;
}

#welcome {
    margin-bottom: 1;
    text-style: bold;
}

#screen_content {
    padding: 1;
    height: 1fr;
}

#chat_messages {
    height: 1fr;
}

/* Keep the settings prompt editor compact so it never overlaps
   the blocks above it (LinkedIn login, buttons, etc.). */
#system_prompt {
    height: 6;
}

#linkedin_block {
    height: auto;
}

HeaderIcon {
    width: 9;
    padding: 0 2;
    text-style: bold;
    background: $primary;
    color: $background;
}

/* Make the chat input area visually distinct from the transcript. */
#chat_input {
    margin-top: 1;
    background: $panel;
    border: tall $secondary;
    padding: 0 2;
}

#chat_input > .input--placeholder {
    color: $primary;
    text-style: italic;
}
